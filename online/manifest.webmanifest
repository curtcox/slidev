{
  "id": "./",
  "name": "Slidev Online",
  "short_name": "Slidev",
  "description": "Author, preview and present Slidev decks in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f0f5f7",
  "theme_color": "#087eac",
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
